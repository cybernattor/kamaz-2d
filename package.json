    "test:traffic": "tsx repros/traffic-flow.repro.ts",
    "test:traffic:stop-line": "tsx repros/traffic-stop-line.repro.ts",
    "test:traffic:accident": "tsx repros/traffic-accident.repro.ts",
    "test:traffic:ground-bypass": "tsx repros/traffic-ground-bypass.repro.ts",
    "test:traffic:player-following": "tsx repros/traffic-player-following.repro.ts",
    "test:traffic:adaptive-route": "tsx repros/traffic-adaptive-route.repro.ts",
    "test:map:lanes": "tsx repros/map-lane-direction.repro.ts",
    "test:map:network": "tsx repros/map-network.repro.ts",
    "test:map:geometry": "tsx repros/map-geometry-integrity.repro.ts",
    "test:map:placement": "tsx repros/map-static-placement.repro.ts",
    "test:traffic:route-planning": "tsx repros/traffic-route-planning.repro.ts",
    "test:mp:protocol": "tsx repros/multiplayer-protocol.repro.ts",
    "test:mp:interpolation": "tsx repros/multiplayer-interpolation.repro.ts",
    "test:pedestrian-contact": "tsx repros/pedestrian-contact.repro.ts",
    "test:pedestrian-horn": "tsx repros/pedestrian-horn.repro.ts",
    "test:pedestrian-sidewalk": "tsx repros/pedestrian-sidewalk.repro.ts",
    "test:physics-particles": "tsx repros/physics-particle-api.repro.ts",
    "test:fixed-step": "tsx repros/fixed-step.repro.ts",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pixi.js": "^8.16.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
